# Production / Neon Postgres (free tier)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NEXTAUTH_URL="https://scholarreach-ai.vercel.app"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Optional seed target for private migrations (never commit real .env)
DEFAULT_USER_EMAIL="you@university.edu"
DEFAULT_USER_NAME="Student Researcher"

# Protects existing workspaces that already hold private outreach data
WORKSPACE_ACCESS_CODE="choose-a-private-code"

# Fail closed in production
ALLOW_DEFAULT_USER="false"

# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI must be exactly:
#   https://scholarreach-ai.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://scholarreach-ai.vercel.app/api/auth/callback/google"

# Optional operator-paid mining APIs (students are never billed)
PROVOCATIVE_BASE_URL=""
PROVOCATIVE_API_KEY=""
PRIMARY_MODEL="qwen3.6-35b"
EXA_API_KEY=""
TAVILY_API_KEY=""
FIRECRAWL_API_KEY=""

DAILY_SEND_CAP="500"
# Keep true on free Hobby until Gmail OAuth is intentionally enabled
DRIP_DRY_RUN="true"
NEXT_PUBLIC_LIVE_APP_URL="https://scholarreach-ai.vercel.app"
