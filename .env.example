# Production / Neon Postgres (free tier) — never commit real credentials
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NEXTAUTH_URL="https://scholarreach-ai.vercel.app"
NEXTAUTH_SECRET="generate-a-long-random-string"

DEFAULT_USER_EMAIL="you@university.edu"
DEFAULT_USER_NAME="Student Researcher"
ALLOW_DEFAULT_USER="false"

# Google Sign-In (identity) + Gmail connect callback
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (both):
#   https://scholarreach-ai.vercel.app/api/auth/callback/google
#   https://scholarreach-ai.vercel.app/api/mail/gmail/callback
# Authorized JS origins:
#   https://scholarreach-ai.vercel.app
#   http://localhost:3001
# OAuth consent: External, add your Family Link Google account as a Test user
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://scholarreach-ai.vercel.app/api/auth/callback/google"

# Optional Microsoft / Outlook Sign-In
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ── LLM providers (failover chain — first configured + healthy wins) ──
# Order: Groq → OpenRouter → Mistral → Gemini → Lightning/compat → Provocative

# Groq (preferred free speed) — https://console.groq.com
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL_FAST="llama-3.1-8b-instant"
GROQ_MODEL_QUALITY="llama-3.3-70b-versatile"
GROQ_MIN_INTERVAL_MS="2200"

# OpenRouter — https://openrouter.ai (many free models with :free suffix)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL_FAST="meta-llama/llama-3.2-3b-instruct:free"
OPENROUTER_MODEL_QUALITY="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_SITE_URL="https://scholarreach-ai.vercel.app"
OPENROUTER_APP_NAME="ScholarReach"

# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
MISTRAL_MODEL_FAST="mistral-small-latest"
MISTRAL_MODEL_QUALITY="mistral-small-latest"

# Gemini (OpenAI-compatible) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# or GOOGLE_AI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL_FAST="gemini-2.0-flash-lite"
GEMINI_MODEL_QUALITY="gemini-2.0-flash"

# Novita (OpenAI-compatible) — https://novita.ai/docs/guides/llm-api
NOVITA_API_KEY=""
NOVITA_BASE_URL="https://api.novita.ai/openai/v1"
NOVITA_MODEL_FAST="meta-llama/llama-3.2-1b-instruct"
NOVITA_MODEL_QUALITY="meta-llama/llama-3.1-8b-instruct"

# Lightning AI LitServe / any OpenAI-compatible GPU endpoint
# Deploy with: lightning api deploy server.py --cloud  (OpenAISpec)
# Then paste the public URL ending in /v1
LIGHTNING_BASE_URL=""
LIGHTNING_API_KEY=""
LIGHTNING_MODEL="default"
# Generic alias:
# LLM_COMPAT_BASE_URL=""
# LLM_COMPAT_API_KEY=""
# LLM_COMPAT_MODEL="default"

# Legacy fallback if nothing else is set
PROVOCATIVE_BASE_URL=""
PROVOCATIVE_API_KEY=""
PRIMARY_MODEL="qwen3.6-35b"
EXA_API_KEY=""
TAVILY_API_KEY=""
FIRECRAWL_API_KEY=""

DAILY_SEND_CAP="500"
DRIP_DRY_RUN="false"
NEXT_PUBLIC_LIVE_APP_URL="https://scholarreach-ai.vercel.app"

# Scalable transactional email (Resend) — preferred over Gmail SMTP / Apps Script
# Create key + verify domain at https://resend.com
# Free tier is fine for testing; upgrade Resend (or swap to SES later) for volume
RESEND_API_KEY=""
RESEND_FROM="ScholarReach <outreach@your-verified-domain.com>"

# Free-tier search budgets (per user / day)
SEARCH_DAILY_BUDGET_EXA="15"
SEARCH_DAILY_BUDGET_TAVILY="40"
SEARCH_DAILY_BUDGET_FIRECRAWL="25"
SEARCH_DAILY_BUDGET_LLM="80"
TAVILY_SEARCH_DEPTH="basic"
TAVILY_TIMEOUT_MS="12000"
FIRECRAWL_TIMEOUT_MS="15000"
MINE_TICK_TIMEOUT_MS="55000"
# Prefer structured template for outreach drafts (set true to allow Groq polish)
USE_LLM_EMAIL_DRAFTS="false"
MIN_MATCH_SCORE="40"
