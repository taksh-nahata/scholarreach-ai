{
  "name": "scholarreach-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "demo:export": "tsx scripts/export-demo-data.ts",
    "drip:dry-run": "tsx scripts/drip_dry_run.ts",
    "build:gh-pages": "node scripts/build-gh-pages.cjs",
    "test": "tsx scripts/drip_dry_run.ts && tsx tests/faculty_email_scoring.test.ts && tsx tests/reliability_helpers.test.ts && tsx tests/outreach_letter.test.ts && tsx tests/reply_parser.test.ts",
    "test:email": "tsx tests/faculty_email_scoring.test.ts",
    "test:letter": "tsx tests/outreach_letter.test.ts",
    "test:reliability": "tsx tests/reliability_helpers.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "5.22.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.43.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.27.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
